# Docker cloud example (copy to .env.docker.cloud and fill real values)

APP_ENV=production
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_ADMIN_PORT=8000
APP_EXPERIENCE_PORT=8001
LOG_LEVEL=INFO

# Required
DASHSCOPE_API_KEY=sk-your_api_key_here
GENERATION_GUARD_MODEL=qwen3.5-flash
CHART_WORKER_MODEL=qwen3.5-plus
FINAL_REPLY_MODEL_MAX=qwen3.7-max
CHART_WORKER_ENABLE_THINKING=false
SUPERVISOR_TERMINAL_WORKER_TIMEOUT_SEC=300
SUPERVISOR_BACKGROUND_TASK_TIMEOUT=300

# Database (mysql service in compose)
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=rootpassword
DB_NAME=DeluData
DB_ENCRYPTION_KEY=replace_with_your_fernet_key

# Redis (redis service in compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# OCR mode for cloud (CPU machine)
RAG_OCR_DEVICE=cpu
RAG_OCR_GPU_FALLBACK_TO_CPU=true
RAG_OCR_PIPELINE_MODE=windowed_v2

# Keep ingestion worker enabled
RAG_INGEST_USE_DB_QUEUE=true
