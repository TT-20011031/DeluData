# ============================================
# DeluData 配置模板
# 复制此文件为 .env 并填入实际值
# ============================================

# --- 数据库配置 ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=DeluData

# --- LLM 配置 (通义千问) ---
DASHSCOPE_API_KEY=sk-your_api_key_here
GENERATION_GUARD_MODEL=qwen3.5-flash
CHART_WORKER_MODEL=qwen3.5-plus
FINAL_REPLY_MODEL_MAX=qwen3.7-max
CHART_WORKER_ENABLE_THINKING=false
SUPERVISOR_TERMINAL_WORKER_TIMEOUT_SEC=300
SUPERVISOR_BACKGROUND_TASK_TIMEOUT=300

# --- 应用配置 ---
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=your_secret_key_here
APP_HOST=0.0.0.0
APP_PORT=8000

# --- 存储配置 ---
# local | oss
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data/storage
STORAGE_TEMP_DIR=./data/.storage-tmp
STORAGE_SIGNED_URL_TTL_SEC=1800

# --- 阿里云 OSS 配置 ---
OSS_BUCKET=delu-agent
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_REGION=cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SECURITY_TOKEN=
OSS_KEY_PREFIX=

# --- ChromaDB 配置 ---
CHROMA_PERSIST_DIR=./data/chroma

# --- 数据库连接加密配置 ---
# 用于加密用户数据库连接密码的密钥（Fernet格式，44字符）
# 重要：一旦设置请勿更改，否则已保存的连接将无法解密
DB_ENCRYPTION_KEY=ZGV2X29ubHlfZml4ZWRfa2V5XzMyYnl0ZXM9PT0=

# --- 日志配置 ---
LOG_LEVEL=INFO

# --- OCR 配置 ---
# cpu | gpu（gpu 需安装 onnxruntime-gpu；不可用时可自动回退 CPU）
RAG_OCR_PIPELINE_MODE=windowed_v2
RAG_OCR_DEVICE=gpu
RAG_OCR_GPU_FALLBACK_TO_CPU=true
RAG_OCR_GPU_CONSERVATIVE_MODE=true
RAG_OCR_IMAGE_AREA_THRESHOLD=0.30
RAG_OCR_DPI=175
RAG_OCR_WORKER_MAX_OCR_IMAGE_HEIGHT_PX=2200
RAG_OCR_WORKER_MAX_RENDER_PIXELS=18000000
RAG_OCR_DET_DB_BOX_THRESH=0.45
RAG_OCR_DET_DB_UNCLIP_RATIO=1.3

# --- 多模态图片传递 ---
# base64: 开发环境推荐（无需公网可访问 URL）
# url: 生产环境推荐（使用签名 URL）
RAG_MM_IMAGE_TRANSFER_MODE=base64
RAG_MM_IMAGE_URL_TTL_SEC=1800
